{
  "name": "no-origins",
  "private": true,
  "description": "No Origins: one workspace for the app, the Eidos packages, noi's scripts and the Supabase tools. Rust keeps its own Cargo workspace in noi.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter explorer dev",
    "check": "node scripts/check.mjs",
    "check:app": "node scripts/check.mjs --app",
    "check:rust": "node scripts/check.mjs --rust",
    "check:scripts": "node scripts/check.mjs --scripts",
    "land": "node scripts/land.mjs",
    "eio:write": "cargo run -q --manifest-path noi/Cargo.toml -p noi-eio --bin eio-write --"
  }
}
