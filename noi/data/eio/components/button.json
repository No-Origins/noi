{
  "path": "noi.eio.components.button",
  "name": "Button",
  "classification": {
    "type": "component"
  },
  "semantics": {
    "definition": "A real button: keyboards and screen readers work, it shows the focus ring and has a 44 px touch target. Given an address, a real link instead.",
    "responsibility": "Be the one button every No Origins app uses. It changes only through a proposal you approve; Mero keeps the fingerprints of the version you approved, git keeps the code."
  },
  "authority_scope": "ea248469-04ce-4f5d-959e-b66c5fd5fbed",
  "spec": {
    "package": "@noi/eio-react",
    "part": "component",
    "job": "Do something when pressed, or take you somewhere: the one main action, the other strong one, or any other.",
    "states": {
      "variant": {
        "primary": "for the one main action",
        "secondary": "for the other strong one",
        "plain": "for the rest"
      },
      "size": {
        "default": "40 px",
        "large": "48 px, for a screen’s single big action"
      },
      "width": {
        "content": "as wide as its words",
        "wide": "as wide as its container"
      },
      "link": {
        "inside": "a link to a place in No Origins: still a button, the arrow after its words",
        "action": "a link that does something: its icon, or a picture of who, instead of the arrow",
        "outside": "a link to a place outside No Origins: words with a dashed underline and the arrow, in a new tab"
      },
      "interaction": {
        "hover": "hovered",
        "focus": "focused, with the focus ring",
        "disabled": "disabled"
      }
    },
    "reads": [
      "noi.eio.border.width.default",
