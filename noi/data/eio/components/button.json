      "noi.eio.color.border.input",
      "noi.eio.color.focus.ring",
      "noi.eio.color.state.hover",
      "noi.eio.color.surface.page",
      "noi.eio.color.text.faint",
      "noi.eio.color.text.muted",
      "noi.eio.color.text.primary",
      "noi.eio.motion.duration.ms100",
      "noi.eio.motion.easing.standard",
      "noi.eio.radius.button",
      "noi.eio.size.control.default",
      "noi.eio.size.control.large",
