      "noi.eio.world.movement.ceiling",
      "noi.eio.world.movement.fly",
      "noi.eio.world.movement.hover",
      "noi.eio.world.movement.jump",
      "noi.eio.world.movement.rise",
      "noi.eio.world.movement.run",
      "noi.eio.world.movement.walk"
    ],
    "uses": [
