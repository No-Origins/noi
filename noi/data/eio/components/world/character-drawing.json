{
  "path": "noi.eio.components.world.character-drawing",
  "name": "Character drawing",
  "classification": {
    "type": "component"
  },
  "semantics": {
    "definition": "The code that draws any of the characters in the 3D world: it loads a character’s model, its look and its wings when the character is first shown, puts them into the world’s own three.js scene, standing as tall as a character is, and plays what its state says: standing plainly, or its walk or its run. And the numbers the characters carry: their height and the room they take up, how they move, their flight into a system, and the eye that follows them.",
    "responsibility": "Hold what several Eidos components share, once. It changes only through a proposal you approve; Mero keeps the fingerprints of the version you approved, git keeps the code."
  },
  "authority_scope": "ea248469-04ce-4f5d-959e-b66c5fd5fbed",
  "spec": {
    "package": "@noi/eio-3d",
    "part": "shared-part",
    "job": "Draw any of the characters in the world’s three.js scene, standing, walking or running, at Eidos’s height.",
    "states": {
      "motion": {
        "stand": "standing plainly, arms down",
        "walk": "walking",
        "run": "running"
      },
      "measure": {
        "height": "Character height",
        "stepUp": "Highest step without a jump",
        "walk": "Walk",
        "run": "Run",
        "fly": "Fly",
        "rise": "Rise and sink",
        "jump": "Jump height",
        "hover": "Hover height",
        "ceiling": "Flight ceiling",
        "jumpHeight": "Flight jump height",
        "jumpTime": "Flight jump time",
        "topSpeed": "Flight top speed",
        "catchUp": "Eye catch-up time",
        "leastIn": "Least time in a gateway",
        "dark": "Going dark",
        "onFoot": "Eye on foot",
        "eyeJump": "Eye in the jump",
        "chase": "Eye in fast flight",
        "eyeGateway": "Eye in a gateway"
      }
    },
    "reads": [
      "noi.eio.color.world.light",
      "noi.eio.world.character.arms-out",
      "noi.eio.world.character.depth",
      "noi.eio.world.character.height",
