      "noi.eio.color.border.default",
      "noi.eio.color.surface.raised",
      "noi.eio.color.text.danger",
      "noi.eio.color.text.faint",
      "noi.eio.color.text.primary",
      "noi.eio.color.text.success",
      "noi.eio.color.text.warning",
      "noi.eio.radius.pill",
      "noi.eio.size.control.small",
      "noi.eio.size.dot",
      "noi.eio.space.gap.inline",
      "noi.eio.type.style.label"
    ],
