{
  "path": "noi.eio.components.badge",
  "name": "Badge",
  "classification": {
    "type": "component"
  },
  "semantics": {
    "definition": "A small pill for a state, a status or a plain fact, and the Count beside a tab or a row.",
    "responsibility": "Be the one badge every No Origins app uses. It changes only through a proposal you approve; Mero keeps the fingerprints of the version you approved, git keeps the code."
  },
  "authority_scope": "ea248469-04ce-4f5d-959e-b66c5fd5fbed",
  "spec": {
    "package": "@noi/eio-react",
    "part": "component",
    "job": "Say a state, a status or a number at a glance, always in words: colour is never alone.",
    "states": {
      "tone": {
        "neutral": "a plain fact",
        "danger": "danger, with its icon",
        "warning": "warning, with its icon",
        "success": "success, with its icon"
      },
      "state": {
        "active": "a meron that is active, as a dot",
        "proposed": "a meron that is proposed, as a dot",
        "deprecated": "a meron that is deprecated, as a dot"
      }
    },
    "reads": [
