# Mero's own database login on this Mac. The real one is in mero.local.env (owner-only, ignored
# by Git), written by infrastructure/supabase/runtime-logins.py. Never use a browser-side key here.
DATABASE_URL=postgresql://noi_mer_runtime:PASSWORD@127.0.0.1:55322/postgres
# Governance's server, which Mero asks about every request.
NOI_GOV_URL=http://127.0.0.1:8788

# Governance's own login, for noi-gov (governance.local.env):
# NOI_GOV_DATABASE_URL=postgresql://noi_gov_runtime:PASSWORD@127.0.0.1:55322/postgres

# For `noi propose`: a run token from Hyperbase's tool runner, or this Mac's key to get one.
# NOI_RUN_TOKEN=
# NOI_VOUCH_KEY=hyperbase-vouch.local.pem
